# --- App ---
APP_NAME="AI WhatsApp CRM"
ENVIRONMENT=development
DEBUG=true

# --- Security ---
SECRET_KEY=change-me-to-a-random-64-char-string
ACCESS_TOKEN_EXPIRE_MINUTES=60
ALGORITHM=HS256

# --- Database ---
DATABASE_URL=postgresql+psycopg2://crm_user:crm_password@localhost:5432/crm_db

# --- AI Provider ---
AI_PROVIDER=gemini
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_CHAT_MODEL=gemini-3.5-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-2

# --- Messaging Provider ---
MESSAGING_PROVIDER=simulated

# --- Follow-up Rules scheduler ---
FOLLOW_UP_SCHEDULER_ENABLED=true
FOLLOW_UP_SCHEDULER_INTERVAL_MINUTES=15

# --- CORS ---
CORS_ORIGINS=http://localhost:5173
